<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Blue Orbit Ring Top Arc -->
    <path
        android:pathData="M 30,24 A 32,32 0 0,1 78,24"
        android:strokeWidth="2.5"
        android:strokeColor="#FF00A3FF"
        android:strokeLineCap="round"/>

    <!-- Glowing Blue Orbit Ring Bottom Arc -->
    <path
        android:pathData="M 32,82 A 32,32 0 0,0 76,82"
        android:strokeWidth="2.5"
        android:strokeColor="#FF0088FF"
        android:strokeLineCap="round"/>

    <!-- Left Blue Wing of X -->
    <path
        android:pathData="M 24,30 L 46,30 L 65,52 L 46,74 L 24,74 L 42,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="30"
                android:endX="65"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00C6FF"/>
                <item android:offset="0.6" android:color="#FF0072FF"/>
                <item android:offset="1.0" android:color="#FF0044CC"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right White/Silver Wing of X -->
    <path
        android:pathData="M 84,30 L 62,30 L 43,52 L 62,74 L 84,74 L 66,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="84"
                android:startY="30"
                android:endX="43"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF"/>
                <item android:offset="0.5" android:color="#FFE2E8F0"/>
                <item android:offset="1.0" android:color="#FF94A3B8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Intersection Highlight Accent -->
    <path
        android:pathData="M 52,42 L 56,42 L 60,52 L 56,62 L 52,62 L 55,52 Z"
        android:fillColor="#33FFFFFF"/>

    <!-- ConnectX 3 Glowing Status Dots at bottom -->
    <path
        android:pathData="M 46,86 A 1.5,1.5 0 1,1 46,85.9 Z"
        android:fillColor="#FF00D2FF"/>
    <path
        android:pathData="M 54,86 A 1.5,1.5 0 1,1 54,85.9 Z"
        android:fillColor="#FF00A3FF"/>
    <path
        android:pathData="M 62,86 A 1.5,1.5 0 1,1 62,85.9 Z"
        android:fillColor="#FF0072FF"/>

</vector>
